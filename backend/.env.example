MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/joinapp?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
PORT=4000
NODE_ENV=development
CORS_ORIGINS=https://your-web-app.example
PUBLIC_APP_URL=https://your-public-app.example
PASSWORD_RESET_BASE_URL=https://your-public-app.example
MAPTILER_API_KEY=your_maptiler_key_for_coordinate_backfills
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=JOIN <no-reply@joinapp.com>
IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=join
# Development-only alternative: IMAGE_STORAGE_PROVIDER=local
# IMAGE_LOCAL_DIR=./uploads
# IMAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
# Development-only demo seed safeguards:
# DEMO_SEED_CONFIRM=CREATE_JOIN_TEST_DATA
# DEMO_SEED_PASSWORD=set_a_unique_test_password_of_12_or_more_characters
