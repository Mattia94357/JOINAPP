MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/joinapp?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
PORT=4000
NODE_ENV=development
CORS_ORIGINS=https://your-web-app.example
PUBLIC_APP_URL=https://your-public-app.example
PASSWORD_RESET_BASE_URL=https://your-public-app.example
MAPTILER_API_KEY=your_maptiler_key_for_coordinate_backfills
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=JOIN <no-reply@joinapp.com>
IMAGE_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_BASE_URL=https://images.your-domain.example
IMAGE_UPLOADS_ENABLED=true
IMAGE_UPLOAD_DAILY_USER_LIMIT=20
IMAGE_UPLOAD_SHORT_WINDOW_LIMIT=5
IMAGE_UPLOAD_SHORT_WINDOW_MINUTES=10
IMAGE_UPLOAD_IP_LIMIT=20
GLOBAL_DAILY_IMAGE_UPLOAD_LIMIT=1000
GLOBAL_DAILY_IMAGE_UPLOAD_BYTES=1000000000
IMAGE_ASSET_MAX_PER_USER=100
# Development-only alternative: IMAGE_STORAGE_PROVIDER=local
# IMAGE_LOCAL_DIR=./uploads
# IMAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
# Development-only demo seed safeguards:
# DEMO_SEED_CONFIRM=CREATE_JOIN_TEST_DATA
# DEMO_SEED_PASSWORD=set_a_unique_test_password_of_12_or_more_characters
